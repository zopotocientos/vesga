# Supabase — from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Scan security — a secret string used to authorize scan triggers
# Generate one with: openssl rand -hex 32
SCAN_SECRET=your-random-secret-here

# Email — who receives the daily report
REPORT_EMAIL_TO=you@example.com
REPORT_EMAIL_FROM=monitor@yourdomain.com

# Set to "true" to always send an email even when no matches found
SEND_EMPTY_REPORTS=false

# --- Choose ONE email provider and uncomment it ---

# Option A: Resend (recommended — easy setup at resend.com)
# RESEND_API_KEY=re_...

# Option B: SendGrid
# SENDGRID_API_KEY=SG....

# Option C: Any SMTP (e.g. Gmail, Postmark, Mailgun)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
